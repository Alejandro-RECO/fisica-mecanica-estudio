---
import Nav from '../componentes/Nav.astro';
import '../estilos/estudio.css';
import 'katex/dist/katex.min.css';

interface Props {
  titulo: string;
  descripcion?: string;
}
const { titulo, descripcion } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Física Mecánica</title>
    {descripcion && <meta name="description" content={descripcion} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;600&display=swap"
    />

    <script is:inline>
      // Se aplica antes de pintar para que ni el modo ni el menu parpadeen.
      try {
        const r = document.documentElement;
        if (localStorage.getItem('modo') === 'repaso') r.classList.add('solo-esencial');
        const nav = localStorage.getItem('nav');
        // En movil el menu arranca plegado: ahi es un panel que tapa la
        // lectura. En escritorio arranca visible. La preferencia manda.
        const plegado = nav === null ? window.matchMedia('(max-width: 860px)').matches : nav === 'oculta';
        if (plegado) r.classList.add('nav-oculta');
      } catch (e) {
        /* navegacion privada o cookies bloqueadas: se usa el estado por defecto */
      }
    </script>
  </head>

  <body>
    <button class="nav-toggle no-print" type="button" id="nav-toggle" aria-controls="nav" aria-expanded="true">
      <span class="visualmente-oculto" id="nav-toggle-texto">Ocultar el menú</span>
      <svg class="icono-plegar" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
        <path d="M1.5 1.5v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M13 7.5H5m0 0 3-3m-3 3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <svg class="icono-desplegar" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
        <path d="M1.5 3h12M1.5 7.5h12M1.5 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <button
      class="nav-fondo no-print"
      type="button"
      id="nav-fondo"
      tabindex="-1"
      aria-hidden="true"
    ></button>

    <div class="armazon">
      <Nav />
      <slot />
    </div>

    <button class="modo no-print" type="button" aria-pressed="false" id="modo">
      <span class="modo-punto" aria-hidden="true"></span>
      <span id="modo-texto">Modo estudio</span>
    </button>

    <script is:inline>
      (() => {
        const raiz = document.documentElement;
        const guardar = (k, v) => {
          try {
            localStorage.setItem(k, v);
          } catch (e) {
            /* si no se puede guardar, el cambio vale para esta pagina y ya */
          }
        };

        // --- modo estudio / repaso ---
        const boton = document.getElementById('modo');
        const texto = document.getElementById('modo-texto');
        const pintarModo = () => {
          const repaso = raiz.classList.contains('solo-esencial');
          texto.textContent = repaso ? 'Modo repaso' : 'Modo estudio';
          boton.setAttribute('aria-pressed', String(repaso));
        };
        boton.addEventListener('click', () => {
          const repaso = raiz.classList.toggle('solo-esencial');
          guardar('modo', repaso ? 'repaso' : 'estudio');
          pintarModo();
        });
        pintarModo();

        // --- menu plegable ---
        const alternar = document.getElementById('nav-toggle');
        const rotulo = document.getElementById('nav-toggle-texto');
        const fondo = document.getElementById('nav-fondo');
        const pintarNav = () => {
          const oculta = raiz.classList.contains('nav-oculta');
          alternar.setAttribute('aria-expanded', String(!oculta));
          rotulo.textContent = oculta ? 'Mostrar el menú' : 'Ocultar el menú';
          alternar.title = rotulo.textContent;
        };
        alternar.addEventListener('click', () => {
          const oculta = raiz.classList.toggle('nav-oculta');
          guardar('nav', oculta ? 'oculta' : 'visible');
          pintarNav();
        });
        // En movil el menu es un cajon sobre el contenido: tocar fuera de el
        // lo cierra, como en cualquier menu de telefono. Sin esto el fondo
        // se queda a medias visible detras del menu abierto.
        fondo?.addEventListener('click', () => {
          raiz.classList.add('nav-oculta');
          guardar('nav', 'oculta');
          pintarNav();
        });
        pintarNav();
      })();
    </script>
  </body>
</html>
