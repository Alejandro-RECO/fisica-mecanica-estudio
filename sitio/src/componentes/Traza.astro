---
// La traza de procedencia — el elemento de firma del sitio.
//
// Todo lo que se afirma aqui salio de algun lado, y ese lado se ve. Sin
// esto el sitio seria un resumen mas; con esto se puede auditar cada
// afirmacion contra la clase real.
import Chip from './Chip.astro';

interface Fuente {
  tipo: string;
  ref?: string;
  diapositiva?: number;
  fecha?: Date;
  aporta: string;
}
interface Props {
  fuentes: Fuente[];
  confianza: string;
  estado: string;
  sesiones?: string[];
  tiempoEstudio?: number;
  tiempoRepaso?: number;
}
const { fuentes, confianza, estado, sesiones = [], tiempoEstudio, tiempoRepaso } = Astro.props;

const rotulos: Record<string, string> = {
  diapositivas: 'Diapositiva',
  tablero: 'Tablero',
  apuntes: 'Apuntes',
  taller: 'Taller',
  abierta: 'Fuente abierta',
  deduccion: 'Deducido aqui',
};

// Solo el nombre del archivo: la ruta completa no aporta al leer.
const corto = (ref?: string) =>
  !ref ? null : ref.startsWith('http') ? new URL(ref).hostname.replace(/^www\./, '') : ref.split('/').pop();
---

<aside class="traza" aria-label="Procedencia del contenido">
  <p class="traza-titulo">De donde salio</p>

  {
    fuentes.map((f) => (
      <div class={`traza-item es-${f.tipo}`}>
        <div>
          <span class="traza-tipo">
            {rotulos[f.tipo] ?? f.tipo}
            {f.diapositiva && ` ${f.diapositiva}`}
          </span>
          <span class="traza-aporta">{f.aporta}</span>
          {f.ref && f.tipo === 'abierta' && (
            <a href={f.ref} rel="noopener noreferrer" target="_blank">
              {corto(f.ref)}
            </a>
          )}
          {f.ref && f.tipo !== 'abierta' && <span class="traza-aporta">{corto(f.ref)}</span>}
        </div>
      </div>
    ))
  }

  <dl class="traza-meta">
    <dt>Confianza</dt>
    <dd><Chip valor={confianza} /></dd>

    <dt>Estado</dt>
    <dd><Chip valor={estado} /></dd>

    {sesiones.length > 0 && (
      <>
        <dt>Sesiones</dt>
        <dd>{sesiones.join(' · ')}</dd>
      </>
    )}

    {tiempoEstudio && (
      <>
        <dt>Lectura</dt>
        <dd>{tiempoEstudio} min · repaso {tiempoRepaso} min</dd>
      </>
    )}
  </dl>
</aside>
