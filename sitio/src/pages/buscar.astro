---
import Base from '../diseno/Base.astro';

// Pagefind indexa el HTML ya construido, asi que su bundle solo existe
// despues de npm run build. En dev no se carga: pedirlo daria 404 y llenaria
// la consola de errores que no son errores.
const construido = import.meta.env.PROD;
---

<Base titulo="Buscar" descripcion="Buscar un concepto en todas las lecciones.">
  <main class="contenido">
    <div class="columna columna-ancha">
    <header class="leccion-cabecera">
      <p class="eyebrow"><a href="/">Estudio</a> — Buscar</p>
      <h1>Buscar un concepto</h1>
      <p class="portada-bajada">
        Busca en el texto de todas las lecciones. Útil cuando recuerdas la idea pero no en qué unidad
        se vio.
      </p>
    </header>

    {
      construido ? (
        <div id="buscador" />
      ) : (
        <div class="vacio">
          <p>
            <strong>El índice de búsqueda todavía no existe.</strong>
          </p>
          <p>
            Pagefind indexa el sitio ya construido. Corre <code>npm run build</code> y luego{' '}
            <code>npm run preview</code> para probarlo.
          </p>
        </div>
      )
    }

    <noscript>
      <div class="vacio">
        <p>El buscador necesita JavaScript. Navega por unidad desde el menú de la izquierda.</p>
      </div>
    </noscript>
    </div>
  </main>

  {
    construido && (
      <>
        <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
        <script is:inline src="/pagefind/pagefind-ui.js" />
        <script is:inline>
          {`window.addEventListener('DOMContentLoaded', () => {
            if (typeof PagefindUI === 'undefined') return;
            new PagefindUI({
              element: '#buscador',
              showSubResults: true,
              showImages: false,
              translations: {
                placeholder: 'Buscar en las lecciones',
                zero_results: 'Nada para [SEARCH_TERM]',
              },
            });
          });`}
        </script>
      </>
    )
  }
</Base>
