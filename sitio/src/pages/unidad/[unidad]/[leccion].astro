---
import { getCollection, render } from 'astro:content';
import Base from '../../../diseno/Base.astro';
import Procedencia from '../../../componentes/Procedencia.astro';
import Disputa from '../../../componentes/Disputa.astro';
import Chip from '../../../componentes/Chip.astro';

export async function getStaticPaths() {
  const lecciones = await getCollection('lecciones');
  return lecciones.map((l) => ({
    params: { unidad: l.data.unidad, leccion: l.id.split('/').pop()! },
    props: { leccion: l },
  }));
}

const { leccion } = Astro.props;
const { Content, headings } = await render(leccion);
const d = leccion.data;

const unidad = (await getCollection('unidades')).find((u) => u.id === d.unidad);
const secciones = headings.filter((h) => h.depth === 2);
---

<Base titulo={d.titulo} descripcion={d.pregunta_guia}>
  <main class="contenido leccion" data-pagefind-body>
    <div class="columna">
    <header class="ficha ancho">
      <p class="eyebrow">
        <a href="/">Estudio</a> — <a href={`/unidad/${d.unidad}/`}>{unidad?.data.titulo ?? d.unidad}</a>
      </p>
      <h1>{d.titulo}</h1>
      <p class="ficha-pregunta">{d.pregunta_guia}</p>

      <dl class="instrumentos">
        <div>
          <dt title="Qué tanto puedes apoyarte en esto para el parcial">Confianza</dt>
          <dd><Chip valor={d.confianza} /></dd>
        </div>
        <div>
          <dt title="Si ya pasó por el revisor conceptual o si todavía es material nuevo">Revisión</dt>
          <dd><Chip valor={d.estado} /></dd>
        </div>
        <div>
          <dt>Estudio</dt>
          <dd>{d.tiempo_estudio_min} min</dd>
        </div>
        <div>
          <dt>Repaso</dt>
          <dd>{d.tiempo_repaso_min} min</dd>
        </div>
        <div>
          <dt>Fuentes</dt>
          <dd>{d.fuentes.length}</dd>
        </div>
      </dl>
    </header>

    <Disputa contradicciones={d.contradicciones} dudas={d.dudas_para_docente} />

    <section class="esencial ancho">
      <h2 id="lo-esencial">Si solo te queda tiempo para esto</h2>
      <ul class="esencial-grid">
        {d.esencial.map((e) => <li><span>{e}</span></li>)}
      </ul>
    </section>

    <Content />

    {
      d.errores_frecuentes.length > 0 && (
        <section class="amplia">
          <h2 id="donde-se-cae-la-gente">Dónde se cae la gente</h2>
          <ul>
            {d.errores_frecuentes.map((e) => (
              <li>{e}</li>
            ))}
          </ul>
        </section>
      )
    }
    </div>

    <aside class="margen no-print" aria-label="Índice y procedencia">
      {
        secciones.length > 1 && (
          <nav class="eje" aria-label="Secciones de la lección">
            <p class="eje-titulo">En esta lección</p>
            <ol>
              {secciones.map((s) => (
                <li>
                  <a href={`#${s.slug}`}>{s.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <Procedencia fuentes={d.fuentes} />
    </aside>
  </main>

  <script is:inline>
    // Marca en el eje la seccion que se esta leyendo. Sin libreria: el
    // observador nativo alcanza y no agrega bundle a la ruta critica.
    (() => {
      const eje = document.querySelector('.eje');
      if (!eje) return;
      const enlaces = new Map(
        [...eje.querySelectorAll('a')].map((a) => [a.getAttribute('href').slice(1), a]),
      );
      const titulos = [...document.querySelectorAll('.contenido h2[id]')].filter((h) =>
        enlaces.has(h.id),
      );
      if (!titulos.length) return;

      let activo = null;
      const marcar = (id) => {
        if (activo === id) return;
        enlaces.forEach((a) => a.removeAttribute('aria-current'));
        enlaces.get(id)?.setAttribute('aria-current', 'true');
        activo = id;
      };

      const obs = new IntersectionObserver(
        (entradas) => {
          const visible = entradas
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible) marcar(visible.target.id);
        },
        { rootMargin: '-64px 0px -70% 0px' },
      );
      titulos.forEach((t) => obs.observe(t));
    })();
  </script>
</Base>
