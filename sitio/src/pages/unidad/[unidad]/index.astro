---
import { getCollection, render } from 'astro:content';
import Base from '../../../diseno/Base.astro';
import Chip from '../../../componentes/Chip.astro';

export async function getStaticPaths() {
  const unidades = await getCollection('unidades');
  return unidades.map((u) => ({ params: { unidad: u.id }, props: { unidad: u } }));
}

const { unidad } = Astro.props;
const { Content } = await render(unidad);

const lecciones = (await getCollection('lecciones'))
  .filter((l) => l.data.unidad === unidad.id)
  .sort((a, b) => a.data.orden - b.data.orden);

const minutos = lecciones.reduce((t, l) => t + l.data.tiempo_estudio_min, 0);
const repaso = lecciones.reduce((t, l) => t + l.data.tiempo_repaso_min, 0);
---

<Base titulo={unidad.data.titulo} descripcion={unidad.data.resumen}>
  <main class="contenido">
    <header class="leccion-cabecera">
      <p class="eyebrow"><a href="/">Estudio</a> — Unidad</p>
      <h1>{unidad.data.titulo}</h1>
      <p class="portada-bajada">{unidad.data.resumen}</p>
      {
        lecciones.length > 0 && (
          <p class="eyebrow">
            {lecciones.length} lecciones · {minutos} min de estudio · {repaso} min de repaso
          </p>
        )
      }
    </header>

    <div class="amplia"><Content /></div>

    {
      lecciones.length === 0 ? (
        <div class="vacio">
          <p>
            Esta unidad todavía no tiene lecciones. Corre <code>/unidad {unidad.id}</code> cuando haya
            material fichado.
          </p>
        </div>
      ) : (
        <ul class="lista-unidades ancho">
          {lecciones.map((l) => (
            <li>
              <a class="unidad-fila" href={`/unidad/${unidad.id}/${l.id.split('/').pop()}/`}>
                <span class="unidad-n">{String(l.data.orden).padStart(2, '0')}</span>
                <span>
                  <span class="unidad-nombre">{l.data.titulo}</span>
                  <span class="unidad-resumen">{l.data.pregunta_guia}</span>
                </span>
                <span class="unidad-pie">
                  <Chip valor={l.data.estado === 'con-dudas' ? 'con-dudas' : l.data.confianza} />
                  <span class="chip">{l.data.tiempo_estudio_min} min</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Base>
